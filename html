<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>B1–B2 Reading Comprehension – Online Test</title>
<style>
  *{box-sizing:border-box;}
  :root{
    --bg:#eef2f7;
    --card:#ffffff;
    --ink:#1e293b;
    --muted:#64748b;
    --line:#e2e8f0;
    --accent:#2563eb;
    --accent-soft:#e0edff;
    --ok:#16a34a;
    --ok-soft:#e8f7ee;
    --bad:#dc2626;
    --bad-soft:#fdeaea;
  }
  html,body{height:100%;margin:0;}
  body{
    font-family:"Segoe UI",system-ui,-apple-system,"Helvetica Neue",Arial,sans-serif;
    background:var(--bg);color:var(--ink);
    display:flex;flex-direction:column;overflow:hidden;
  }

  /* ---------- TOP BAR ---------- */
  .topbar{
    display:flex;align-items:center;justify-content:space-between;gap:14px;
    padding:10px 18px;background:#fff;border-bottom:1px solid var(--line);
    box-shadow:0 1px 4px rgba(15,23,42,.05);flex-wrap:wrap;z-index:5;
  }
  .brand{display:flex;align-items:center;gap:12px;min-width:0;}
  .logo{
    width:38px;height:38px;border-radius:11px;display:grid;place-items:center;
    background:linear-gradient(135deg,#2563eb,#7c3aed);color:#fff;font-size:19px;flex:none;
  }
  .brand h1{font-size:15px;margin:0;letter-spacing:.2px;}
  .brand p{margin:1px 0 0;font-size:12px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}

  .controls{display:flex;align-items:center;gap:9px;flex-wrap:wrap;}
  select#testSelect{
    padding:8px 11px;border-radius:9px;border:1px solid var(--line);background:#f8fafc;
    font-size:13px;font-weight:600;color:var(--ink);cursor:pointer;max-width:280px;
  }
  .timer{
    font-variant-numeric:tabular-nums;font-weight:700;font-size:14px;
    background:#f1f5f9;border:1px solid var(--line);padding:7px 12px;border-radius:9px;color:#334155;
  }
  .timer.warn{background:#fff3cd;border-color:#f0d68a;color:#8a6d1f;}
  button.btn{
    padding:8px 16px;border-radius:9px;border:none;font-size:13px;font-weight:700;
    cursor:pointer;transition:.15s;font-family:inherit;
  }
  .btn-primary{background:var(--accent);color:#fff;box-shadow:0 2px 8px rgba(37,99,235,.3);}
  .btn-primary:hover{background:#1d4ed8;}
  .btn-ghost{background:#f1f5f9;color:#334155;border:1px solid var(--line);}
  .btn-ghost:hover{background:#e2e8f0;}
  .score-box{
    font-size:13px;font-weight:800;padding:7px 13px;border-radius:9px;
    background:var(--accent-soft);color:#1d4ed8;display:none;
  }
  .score-box.show{display:block;}

  /* ---------- MAIN ---------- */
  main{
    flex:1;min-height:0;display:grid;grid-template-columns:1.6fr 1fr;
    gap:14px;padding:14px;overflow:hidden;
  }
  .pane{
    background:var(--card);border-radius:15px;display:flex;flex-direction:column;
    min-height:0;overflow:hidden;box-shadow:0 2px 12px rgba(15,23,42,.07);
    border:1px solid rgba(226,232,240,.9);
  }
  .pane-head{
    display:flex;align-items:center;justify-content:space-between;gap:10px;
    padding:9px 14px;border-bottom:1px solid var(--line);background:#f8fafc;flex-wrap:wrap;flex:none;
  }
  .pane-title{
    font-size:11.5px;font-weight:800;letter-spacing:1.1px;text-transform:uppercase;color:#475569;
  }
  .progress{font-size:12px;font-weight:700;color:var(--accent);background:var(--accent-soft);padding:4px 10px;border-radius:20px;}

  .pane-body{flex:1;overflow-y:auto;padding:20px 24px;scroll-behavior:smooth;}
  .pane-body::-webkit-scrollbar{width:9px;}
  .pane-body::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:8px;}
  .pane-body::-webkit-scrollbar-track{background:transparent;}

  /* ---------- READING ---------- */
  .tabs{display:flex;gap:6px;flex-wrap:wrap;}
  .tab{
    padding:6px 12px;border-radius:8px;border:1px solid var(--line);background:#fff;
    font-size:12px;font-weight:700;color:#475569;cursor:pointer;font-family:inherit;transition:.15s;
  }
  .tab:hover{background:#f1f5f9;}
  .tab.active{background:var(--accent);border-color:var(--accent);color:#fff;box-shadow:0 2px 8px rgba(37,99,235,.28);}

  .passage-title{
    font-size:17px;margin:0 0 4px;color:#0f172a;letter-spacing:.2px;
    padding-bottom:10px;border-bottom:2px solid var(--accent-soft);
  }
  .reading p{font-size:15.5px;line-height:1.85;margin:0 0 15px;color:#233047;text-align:justify;}
  .reading .source{font-size:11.5px;color:#94a3b8;font-style:italic;margin-top:-6px;}
  .person{background:#f8fafc;border-left:3px solid var(--accent);padding:12px 15px;border-radius:0 9px 9px 0;margin-bottom:13px;}
  .person h4{margin:0 0 6px;font-size:14.5px;color:#1d4ed8;}
  .person p{margin:0;font-size:14.5px;line-height:1.72;text-align:left;}

  /* ---------- QUESTIONS ---------- */
  .section{margin-bottom:26px;}
  .sec-head{
    position:sticky;top:-20px;background:#fff;padding:8px 0 8px;z-index:3;
    border-bottom:1px solid var(--line);margin-bottom:14px;
  }
  .sec-head h3{
    margin:0;font-size:12.5px;letter-spacing:1px;text-transform:uppercase;color:var(--accent);font-weight:800;
  }
  .sec-head p{margin:3px 0 0;font-size:12px;color:var(--muted);}

  .hint{
    background:#f8fafc;border:1px dashed #cbd5e1;border-radius:10px;
    padding:11px 14px;margin-bottom:14px;font-size:13px;line-height:1.7;color:#334155;
  }
  .hint b{color:#1d4ed8;}

  .q{
    padding:12px 14px;border-radius:12px;border:1px solid var(--line);
    margin-bottom:11px;transition:.18s;background:#fff;
  }
  .q:hover{border-color:#bfd3f5;}
  .q.correct{background:var(--ok-soft);border-color:#9fdcb6;}
  .q.wrong{background:var(--bad-soft);border-color:#f3b4b4;}
  .q-head{display:flex;gap:9px;align-items:flex-start;margin-bottom:9px;}
  .q-num{
    flex:none;min-width:24px;height:24px;border-radius:7px;background:#eef2f7;color:#475569;
    display:grid;place-items:center;font-size:12px;font-weight:800;
  }
  .q.correct .q-num{background:var(--ok);color:#fff;}
  .q.wrong .q-num{background:var(--bad);color:#fff;}
  .q-text{font-size:14px;line-height:1.55;font-weight:600;color:#1e293b;}

  .opts{display:flex;flex-direction:column;gap:6px;}
  .opt{
    display:flex;gap:9px;align-items:flex-start;padding:8px 11px;border-radius:9px;
    border:1px solid transparent;cursor:pointer;font-size:13.6px;line-height:1.5;transition:.13s;
  }
  .opt:hover{background:#f4f7fc;}
  .opt input{display:none;}
  .badge{
    flex:none;width:21px;height:21px;border-radius:6px;background:#eef2f7;color:#64748b;
    display:grid;place-items:center;font-size:11.5px;font-weight:800;transition:.13s;
  }
  .opt:has(input:checked){background:var(--accent-soft);border-color:#b9d4ff;}
  .opt input:checked ~ .badge{background:var(--accent);color:#fff;}
  .opt input:checked ~ .opt-text{font-weight:700;color:#1d4ed8;}

  select.sel{
    width:100%;padding:9px 11px;border-radius:9px;border:1px solid #cbd5e1;
    font-size:13.5px;font-family:inherit;color:#1e293b;background:#fff;cursor:pointer;
  }
  select.sel:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px rgba(37,99,235,.14);}

  .input-wrap{display:flex;align-items:center;gap:9px;}
  input.txt{
    flex:1;padding:9px 12px;border-radius:9px;border:1px solid #cbd5e1;
    font-size:13.5px;font-family:inherit;color:#1e293b;
  }
  input.txt:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px rgba(37,99,235,.14);}
  .wordlimit{font-size:10.5px;color:#94a3b8;font-weight:700;white-space:nowrap;}

  .q-feedback{margin-top:8px;font-size:12.5px;font-weight:600;display:none;}
  .q-feedback.show{display:block;}
  .q.correct .q-feedback{color:var(--ok);}
  .q.wrong .q-feedback{color:var(--bad);}
  .q-feedback .explain{display:block;font-weight:500;color:#64748b;margin-top:3px;font-style:italic;}

  /* ---------- MOBILE ---------- */
  @media(max-width:1000px){
    html,body{height:auto;overflow:auto;}
    main{grid-template-columns:1fr;overflow:visible;padding:10px;gap:10px;}
    .pane{height:70vh;}
    .pane-body{padding:16px;}
    .brand p{display:none;}
  }
</style>
</head>
