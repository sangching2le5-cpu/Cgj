      instruction: "Questions 21–26 · Answer using NO MORE THAN THREE WORDS from the passage.",
      passage: 2,
      questions: [
        { n:21, type:"text", text:"What do coral reefs help protect?", answers:["coastlines","coastline","the coastlines","the coastline"] },
        { n:22, type:"text", text:"What do corals expel from their tissues during bleaching?", answers:["tiny algae","algae","the tiny algae"] },
        { n:23, type:"text", text:"What may happen to corals if high temperatures continue for a long time?", answers:["become weak","weak","weaken","they become weak","die"] },
        { n:24, type:"text", text:"What can enter the ocean through rivers and rainwater?", answers:["pollution","land pollution"] },
        { n:25, type:"text", text:"What do scientists monitor to understand the condition of coral reefs?", answers:["reef conditions","conditions","reef condition","coral conditions"] },
        { n:26, type:"text", text:"What can local communities support to help protect marine environments?", answers:["marine protection programmes","marine protection programs","marine protection programme","protection programmes","marine programmes"] }
      ]
    },
    {
      title: "IV. Sentence Completion",
      instruction: "Questions 27–30 · Complete using NO MORE THAN THREE WORDS from the passage.",
      passage: 3,
      questions: [
        { n:27, type:"text", text:"During sleep, the brain helps organise newly learned information and form ______.", answers:["memories","memory"] },
        { n:28, type:"text", text:"Students who lack sleep may have difficulty paying ______ in class.", answers:["attention","pay attention"] },
        { n:29, type:"text", text:"Going to bed and waking up at regular times helps establish a consistent ______.", answers:["routine","consistent routine","a routine"] },
        { n:30, type:"text", text:"Students should reduce their ______ in the evening.", answers:["caffeine consumption","caffeine","caffeine intake"] }
      ]
    }
  ]
}
];

/* =========================================================
   STATE
   ========================================================= */
const STORAGE_KEY = "b1b2_reading_app_v1";
const testSelect   = document.getElementById("testSelect");
const timerEl      = document.getElementById("timer");
const scoreBox     = document.getElementById("scoreBox");
const submitBtn    = document.getElementById("submitBtn");
const resetBtn     = document.getElementById("resetBtn");
const readingTabs  = document.getElementById("readingTabs");
const readingBody  = document.getElementById("readingBody");
const answerBody   = document.getElementById("answerBody");
const progressEl   = document.getElementById("progress");
const subtitleEl   = document.getElementById("testSubtitle");

let currentTest   = null;
let activePassage = 0;
let answers       = {};
let submitted     = false;
let elapsed       = 0;
let timerHandle   = null;

/* =========================================================
   STORAGE
   ========================================================= */
function loadStore(){
  try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}"); }
  catch(e){ return {}; }
}
function saveStore(){
  if(!currentTest) return;
  try {
    const data = loadStore();
    data[currentTest.id] = { answers, submitted };
    localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
  } catch(e){}
}

/* =========================================================
   HELPERS
   ========================================================= */
function norm(s){
  return String(s || "")
    .toLowerCase()
    .replace(/[.,;:!?"'’‘“”()\[\]\-–—/]/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}
function totalQuestions(){
  return currentTest.sections.reduce((a,s)=>a+s.questions.length,0);
}

/* =========================================================
   TIMER
   ========================================================= */
function startTimer(){
  clearInterval(timerHandle);
  renderTimer();
  timerHandle = setInterval(()=>{
    elapsed++;
    renderTimer();
  }, 1000);
}
function renderTimer(){
  const m = String(Math.floor(elapsed/60)).padStart(2,"0");
  const s = String(elapsed%60).padStart(2,"0");
  timerEl.textContent = `${m}:${s}`;
  timerEl.classList.toggle("warn", elapsed >= 60*60);
}

/* =========================================================
   RENDER: TEST LIST
   ========================================================= */
TESTS.forEach(t=>{
  const o = document.createElement("option");
  o.value = t.id;
  o.textContent = t.name;
  testSelect.appendChild(o);
});

/* =========================================================
   RENDER: READING
   ========================================================= */
function buildTabs(){
  readingTabs.innerHTML = "";
  currentTest.passages.forEach((p, i)=>{
    const b = document.createElement("button");
    b.className = "tab" + (i === activePassage ? " active" : "");
    b.textContent = p.label;
    b.addEventListener("click", ()=>selectPassage(i));
    readingTabs.appendChild(b);
  });
}
function selectPassage(i){
  if(i === activePassage) return;
  activePassage = i;
  renderReading();
  [...readingTabs.children].forEach((b, idx)=>b.classList.toggle("active", idx === i));
}
function renderReading(){
  const p = currentTest.passages[activePassage];
  readingBody.innerHTML = `<h2 class="passage-title">${p.title}</h2>` + p.html;
  readingBody.scrollTop = 0;
}

/* =========================================================
   RENDER: ANSWER SHEET
   ========================================================= */
function buildQuestion(q, sec){
  const el = document.createElement("div");
  el.className = "q";
  el.dataset.n = q.n;
  el.dataset.passage = sec.passage;

  let inner = `<div class="q-head"><span class="q-num">${q.n}</span><span class="q-text">${q.text}</span></div>`;

  if(q.type === "mc"){
    inner += `<div class="opts">` + q.options.map((t, i)=>{
      const L = "ABCD"[i];
      return `<label class="opt">
        <input type="radio" name="q${q.n}" value="${L}">
        <span class="badge">${L}</span>
        <span class="opt-text">${t}</span>
      </label>`;
    }).join("") + `</div>`;
  } else if(q.type === "select"){
    inner += `<div class="select-wrap"><select class="sel" data-n="${q.n}">
      <option value="">— choose an answer —</option>` +
      q.options.map(o=>`<option value="${o.value}">${o.label}</option>`).join("") +
      `</select></div>`;
  } else {
    inner += `<div class="input-wrap">
      <input type="text" class="txt" data-n="${q.n}" autocomplete="off" spellcheck="false" placeholder="Type your answer…">
      <span class="wordlimit">≤ 3 words</span>
    </div>`;
  }

  inner += `<div class="q-feedback"></div>`;
  el.innerHTML = inner;
  return el;
}

function renderAnswers(){
  answerBody.innerHTML = "";
  currentTest.sections.forEach(sec=>{
    const secEl = document.createElement("section");
    secEl.className = "section";

    const head = document.createElement("div");
    head.className = "sec-head";
    head.innerHTML = `<h3>${sec.title}</h3><p>${sec.instruction || ""}</p>`;
    secEl.appendChild(head);

    if(sec.hint){
      const h = document.createElement("div");
      h.className = "hint";
      h.innerHTML = sec.hint;
      secEl.appendChild(h);
    }

    sec.questions.forEach(q => secEl.appendChild(buildQuestion(q, sec)));
    answerBody.appendChild(secEl);
  });

  restoreAnswers();
  updateProgress();
  scoreBox.classList.remove("show");
}

function restoreAnswers(){
  answerBody.querySelectorAll('input[type="radio"]').forEach(r=> r.checked = false);
  answerBody.querySelectorAll("select.sel").forEach(s=> s.value = "");
  answerBody.querySelectorAll("input.txt").forEach(i=> i.value = "");
  answerBody.querySelectorAll(".q").forEach(q=>{
    q.classList.remove("correct","wrong");
    const fb = q.querySelector(".q-feedback");
    fb.className = "q-feedback";
    fb.innerHTML = "";
  });

  Object.entries(answers).forEach(([n, v])=>{
    if(!v) return;
    const radios = answerBody.querySelectorAll(`input[name="q${n}"]`);
    if(radios.length){
      radios.forEach(r=>{ if(r.value === v) r.checked = true; });
      return;
    }
    const sel = answerBody.querySelector(`select.sel[data-n="${n}"]`);
    if(sel){ sel.value = v; return; }
    const txt = answerBody.querySelector(`input.txt[data-n="${n}"]`);
    if(txt) txt.value = v;
  });

  if(submitted) grade(true);
}

/* =========================================================
   ANSWERS / PROGRESS
   ========================================================= */
function setAnswer(n, v){
  answers[n] = v;
  clearMark(n);
  updateProgress();
  saveStore();
}
function clearMark(n){
  const el = answerBody.querySelector(`.q[data-n="${n}"]`);
  if(!el) return;
  el.classList.remove("correct","wrong");
  const fb = el.querySelector(".q-feedback");
  if(fb){ fb.className = "q-feedback"; fb.innerHTML = ""; }
}
function updateProgress(){
  let done = 0;
  currentTest.sections.forEach(sec=>sec.questions.forEach(q=>{
    if((answers[q.n] || "").trim()) done++;
  }));
  progressEl.textContent = `${done} / ${totalQuestions()}`;
}

/* =========================================================
   EVENTS ON ANSWER SHEET
   ========================================================= */
answerBody.addEventListener("input", e=>{
  const t = e.target;
  if(t.classList.contains("txt")) setAnswer(t.dataset.n, t.value);
});

answerBody.addEventListener("change", e=>{
  const t = e.target;
  if(t.type === "radio" && t.name.startsWith("q")){
    setAnswer(t.name.slice(1), t.value);
  }
  if(t.classList.contains("sel")){
    setAnswer(t.dataset.n, t.value);
  }
});

/* auto-switch reading passage when user interacts with a question */
function focusQuestion(e){
  const q = e.target.closest(".q");
  if(!q) return;
  const p = Number(q.dataset.passage);
  if(!Number.isNaN(p) && p !== activePassage){
    selectPassage(p);
  }
}
answerBody.addEventListener("focusin", focusQuestion);
answerBody.addEventListener("click", focusQuestion);

/* =========================================================
   GRADING
   ========================================================= */
function grade(silent){
  let score = 0;
  let total = 0;

  currentTest.sections.forEach(sec=>{
    sec.questions.forEach(q=>{
      total++;
      const raw = (answers[q.n] || "").trim();
      let ok = false;
      let correctText = "";

      if(q.type === "mc"){
        const idx = "ABCD".indexOf(q.answer);
        correctText = `${q.answer} – ${q.options[idx]}`;
        ok = raw === q.answer;
      } else if(q.type === "select"){
        const opt = q.options.find(o=>o.value === q.answer);
        correctText = opt ? opt.label : q.answer;
        ok = raw === q.answer;
      } else {
        correctText = q.answers[0];
        const nr = norm(raw);
        ok = !!nr && q.answers.some(a => norm(a) === nr);
      }

      if(ok) score++;

      const el = answerBody.querySelector(`.q[data-n="${q.n}"]`);
      if(!el) return;
      el.classList.toggle("correct", ok);
      el.classList.toggle("wrong", !ok);

      const fb = el.querySelector(".q-feedback");
      fb.className = "q-feedback show";
      if(ok){
        fb.innerHTML = `✓ Correct` + (q.explain ? `<span class="explain">${q.explain}</span>` : "");
      } else {
        fb.innerHTML = `✗ Correct answer: <b>${correctText}</b>` +
          (q.explain ? `<span class="explain">${q.explain}</span>` : "");
      }
    });
  });

  submitted = true;
  saveStore();

  const pct = Math.round(score / total * 100);
  scoreBox.textContent = `Score: ${score}/${total} (${pct}%)`;
  scoreBox.classList.add("show");

  if(!silent){
    answerBody.scrollTo({ top: 0, behavior: "smooth" });
  }
}

/* =========================================================
   TEST LOADING
   ========================================================= */
function loadTest(id){
  currentTest = TESTS.find(t => t.id === id) || TESTS[0];
  testSelect.value = currentTest.id;

  const saved = loadStore()[currentTest.id];
  answers   = (saved && saved.answers) ? {...saved.answers} : {};
  submitted = false;

  activePassage = 0;
  buildTabs();
  renderReading();
  renderAnswers();

  elapsed = 0;
  startTimer();

  subtitleEl.textContent = `${currentTest.name} · 30 questions · 60 minutes`;
}

/* =========================================================
   BUTTONS
   ========================================================= */
testSelect.addEventListener("change", e => loadTest(e.target.value));

submitBtn.addEventListener("click", ()=>{
  const unanswered = totalQuestions() - Object.values(answers).filter(v => (v||"").trim()).length;
  if(unanswered > 0){
    const ok = confirm(`You still have ${unanswered} unanswered question(s). Submit anyway?`);
    if(!ok) return;
  }
  grade(false);
});

resetBtn.addEventListener("click", ()=>{
  if(!confirm("Clear all answers for this test?")) return;
  answers = {};
  submitted = false;
  elapsed = 0;
  saveStore();
  renderAnswers();
  renderTimer();
  scoreBox.classList.remove("show");
});

/* =========================================================
   INIT
   ========================================================= */
loadTest(TESTS[0].id);
</script>
</body>
</html>
